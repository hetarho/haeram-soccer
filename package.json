{
  "name": "haeram-soccor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests --no-warn-ignored",
    "format": "prettier --write apps packages scripts tests *.json *.ts *.mjs .github",
    "format:check": "prettier --check apps packages scripts tests *.json *.ts *.mjs .github",
    "test:unit": "vitest run --exclude '**/*.contract.test.ts'",
    "test:contract": "vitest run .contract.test.ts",
    "validate:catalogs": "tsx scripts/validate-catalogs.ts",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run test:contract && npm run validate:catalogs && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
