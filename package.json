{
  "name": "haeram-soccor",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests --no-warn-ignored",
    "format": "prettier --write apps packages scripts tests *.json *.ts *.mjs .github",
    "format:check": "prettier --check apps packages scripts tests *.json *.ts *.mjs .github",
    "test:unit": "vitest run --project unit",
    "test:unit:release-on": "vitest run --config vitest.release-on.config.ts --project unit",
    "test:contract": "vitest run --project contract",
    "validate:catalogs": "tsx scripts/validate-catalogs.ts",
    "validate:presentation": "tsx scripts/validate-presentation.ts",
    "art:check": "node scripts/optimize-presentation-art.mjs",
    "art:optimize": "node scripts/optimize-presentation-art.mjs --write",
    "test:e2e": "PREVIEW_BUILD=1 playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "lab:tunables": "tsx scripts/lab-tunables.ts",
    "verify": "node scripts/verify.mjs",
    "benchmark:browser": "node scripts/first-play.mjs",
    "test:integration": "vitest run --project integration",
    "test:integration:release-on": "vitest run --config vitest.release-on.config.ts --project integration",
    "verify:batch": "node scripts/verify.mjs --batch"
  },
  "dependencies": {
    "brotli": "2.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "lucide-static": "1.61.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
