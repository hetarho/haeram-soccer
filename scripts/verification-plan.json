{
  "schemaVersion": 1,
  "checks": [
    {
      "id": "typecheck",
      "tier": "task",
      "command": "pnpm run typecheck",
      "inputs": [
        "apps",
        "packages",
        "tests",
        "scripts",
        "artifacts",
        "patches",
        ".github",
        "*.json",
        "*.ts",
        "*.mjs",
        "*.yaml",
        "*.toml",
        ".gitignore",
        ".prettierignore",
        ".node-version"
      ]
    },
    {
      "id": "lint",
      "tier": "task",
      "command": "pnpm run lint",
      "inputs": [
        "apps",
        "packages",
        "tests",
        "scripts",
        "artifacts",
        "patches",
        ".github",
        "*.json",
        "*.ts",
        "*.mjs",
        "*.yaml",
        "*.toml",
        ".gitignore",
        ".prettierignore",
        ".node-version"
      ]
    },
    {
      "id": "format",
      "tier": "task",
      "command": "pnpm run format:check",
      "inputs": [
        "apps",
        "packages",
        "tests",
        "scripts",
        "artifacts",
        "patches",
        ".github",
        "*.json",
        "*.ts",
        "*.mjs",
        "*.yaml",
        "*.toml",
        ".gitignore",
        ".prettierignore",
        ".node-version"
      ]
    },
    {
      "id": "i18n",
      "tier": "task",
      "command": "pnpm run validate:i18n",
      "inputs": [
        "apps",
        "packages",
        "tests",
        "scripts",
        "artifacts",
        "patches",
        ".github",
        "*.json",
        "*.ts",
        "*.mjs",
        "*.yaml",
        "*.toml",
        ".gitignore",
        ".prettierignore",
        ".node-version"
      ]
    },
    {
      "id": "affected-units",
      "tier": "task",
      "command": "pnpm exec vitest run --project unit --changed \"$GUSTA_DIFF_BASE\" --passWithNoTests",
      "inputs": [
        "apps",
        "packages",
        "tests",
        "scripts",
        "artifacts",
        "patches",
        ".github",
        "*.json",
        "*.ts",
        "*.mjs",
        "*.yaml",
        "*.toml",
        ".gitignore",
        ".prettierignore",
        ".node-version"
      ]
    },
    {
      "id": "verify-batch",
      "tier": "batch",
      "command": "pnpm run verify:batch",
      "inputs": [
        "apps",
        "packages",
        "tests",
        "scripts",
        "artifacts",
        "patches",
        ".github",
        "*.json",
        "*.ts",
        "*.mjs",
        "*.yaml",
        "*.toml",
        ".gitignore",
        ".prettierignore",
        ".node-version"
      ]
    },
    {
      "id": "ci-e2e-chromium-1",
      "tier": "ci",
      "command": "pnpm exec playwright test --project=chromium --shard=1/3"
    },
    {
      "id": "ci-e2e-chromium-2",
      "tier": "ci",
      "command": "pnpm exec playwright test --project=chromium --shard=2/3"
    },
    {
      "id": "ci-e2e-chromium-3",
      "tier": "ci",
      "command": "pnpm exec playwright test --project=chromium --shard=3/3"
    }
  ]
}
