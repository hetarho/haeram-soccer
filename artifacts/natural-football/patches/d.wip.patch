+/**
+ * A clock on the staged timeline. The record has no added-time minutes: it dates every fact of a
+ * complete half's added time to the half's last minute, so that minute's beats are drawn across
+ * the minute and the added time after it, and the picture never stands still waiting for the
+ * whistle (→MATCH-12).
+ */
+export function presentClock(p: FramePeriod, clock: number): number {
+  const length = LENGTH[p.period - 1];
+  const c = clock - OFFSET[p.period - 1] * 60;
+  const last = (length - 1) * 60;
+  const added = p.minutes - length;
+  return p.start + (added > 0 && c > last ? last + (c - last) * (1 + added) : c);
+}
