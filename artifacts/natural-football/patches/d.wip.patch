+++ b/packages/engine/src/staging/tempo.ts
@@ -0,0 +1,144 @@
+/**
+ * The tempo a staging keeps (→MATCH-12): the picture's seconds are fitted to the match clock only
+ * at the record's fixed moments, so the motion program itself plays at the pace those moments
+ * leave. Before a performance it plans when each beat begins on the staged timeline: between two
+ * fixed moments (a recorded shot, its set-up pass, an incident, a half's start and its whistle)
+ * the beats share the time by their nominal lengths. While performing, each beat's hold on the
+ * ball takes up the difference between that plan and where the staging is, within bounds, so a
+ * stretch the script packs is played briskly and one it leaves thin is played patiently; the
+ * players themselves keep their movement-bounded pace throughout.
+ */
+import type { MatchScript, ScriptBeat } from '../../../contracts/src/match-script';
+import { SCRIPT_CONFIG } from '../script/config';
+import { framePeriods, isAnchor, presentClock, shotSources } from './frame-clock';
+import { STAGING_CONFIG } from './config';
+import { RESTART_KINDS } from './types';
+import type { Beat } from './types';
+import { dist } from './vec';
+
+const TEMPO = STAGING_CONFIG.stage.tempo;
+const SCENE = STAGING_CONFIG.stage.scene;
+
+export interface Tempo {
+  /** Planned staged-timeline second each beat begins, by its position in the script. */
+  at: number[];
+  /** Planned seconds each beat's actor has the ball. */
+  hold: number[];
+  /** Planned seconds of incident scenes before each beat's action. */
+  scene: number[];
+  /** The position of the first beat of each beat's period. */
+  first: number[];
+  /** Staged seconds less planned seconds, fixed when a period's first beat begins. */
+  offset: number;
+}
+
+const isRestart = (b: ScriptBeat) => (RESTART_KINDS as readonly string[]).includes(b.kind);
+const isShot = (b: ScriptBeat) =>
+  b.shot !== undefined || b.kind === 'shot' || b.kind === 'penalty' || b.kind === 'shootoutKick';
+
+/** Nominal seconds of a beat's dead ball, its incidents and its ball's travel. */
+function parts(b: ScriptBeat, k: number): { dead: number; scene: number; travel: number } {
+  const dead =
+    b.kind === 'stoppage'
+      ? b.hold
+      : isRestart(b) && !(k === 0 && b.kind === 'kickOff')
+        ? (SCRIPT_CONFIG.dead[b.kind as keyof typeof SCRIPT_CONFIG.dead] ?? 0)
+        : 0;
+  let scene = 0;
+  const incidents = b.incidents ?? [];
+  // Substitutions made together are one scene (`runIncidents`).
+  if (incidents.some((x) => x.kind === 'sub')) scene += SCENE.substitution + TEMPO.subWalk;
+  for (const x of incidents)
+    scene += x.kind === 'injury' ? SCENE.injury : x.kind === 'sub' ? 0 : SCENE.card;
+  const length = dist(b.from, b.to);
+  const speed = TEMPO.speeds;
+  const travel =
+    b.outcome === 'foul'
+      ? 0
+      : length /
+        (isShot(b)
+          ? speed.shot
+          : b.kind === 'carry' || b.kind === 'takeOn'
+            ? speed.carry
+            : b.loft
+              ? speed.loft
+              : speed.ground);
+  return { dead, scene, travel };
+}
+
+/** The planned hold of a beat at the natural pace. */
+const nominalHold = (b: ScriptBeat): number =>
+  isShot(b) || b.kind === 'stoppage' ? 0 : isRestart(b) ? TEMPO.restartHold : TEMPO.hold;
+
+/** Plans every period of `script`, its complete halves including their `added` minutes. */
+export function planTempo(script: MatchScript, added: readonly number[] = []): Tempo {
+  const n = script.beats.length;
+  const at = Array<number>(n).fill(NaN);
+  const hold = Array<number>(n).fill(NaN);
+  const scene = Array<number>(n).fill(0);
+  const first = Array<number>(n).fill(-1);
+  const position = new Map(script.beats.map((b, i) => [b, i]));
+  const sources = shotSources(script);
+  for (const p of framePeriods(script, added)) {
+    const index = p.beats.map((b) => position.get(b)!);
+    const len = p.beats.map((b, k) => {
+      const x = parts(b, k);
+      scene[index[k]!] = x.scene;
+      return x.dead + x.scene + nominalHold(b) + x.travel;
+    });
+    // Fixed moments: the half's start, each recorded moment's beginning, the whistle.
+    const nodes: { k: number; at: number }[] = [{ k: 0, at: p.start }];
+    p.beats.forEach((b, k) => {
+      if (k === 0 || !isAnchor(b, sources)) return;
+      const x = parts(b, k);
+      const begins = presentClock(p, b.clock) - x.dead - x.scene - nominalHold(b);
+      if (begins > nodes.at(-1)!.at) nodes.push({ k, at: begins });
+    });
+    nodes.push({ k: p.beats.length, at: p.start + p.minutes * 60 });
+    for (let j = 0; j + 1 < nodes.length; j++) {
+      const a = nodes[j]!,
+        z = nodes[j + 1]!;
+      let total = 0;
+      for (let k = a.k; k < z.k; k++) total += len[k]!;
+      const scale = total > 0 ? (z.at - a.at) / total : 1;
+      let t = a.at;
+      for (let k = a.k; k < z.k; k++) {
+        const i = index[k]!;
+        at[i] = t;
+        hold[i] = nominalHold(p.beats[k]!) + len[k]! * (scale - 1);
+        first[i] = index[0]!;
+        t += len[k]! * scale;
+      }
+    }
+  }
+  return { at, hold, scene, first, offset: 0 };
+}
+
+/** Fixes the plan's offset as a period's first beat begins at staged second `t`. */
+export function beginBeat(tempo: Tempo, i: number, t: number): void {
+  if (tempo.first[i] === i && Number.isFinite(tempo.at[i]!)) tempo.offset = t - tempo.at[i]!;
+}
+
+/**
+ * The hold `beat` (at position `i`) is played with when its action is about to start at staged
+ * second `t`, `scenes` true when its incidents were staged first: the planned hold less part of
+ * how far the staging runs behind its plan, within the tempo bounds. A shot, a lay-off, a
+ * stoppage and a beat outside the plan keep the script's hold.
+ */
+export function pacedHold(tempo: Tempo, i: number, beat: Beat, t: number, scenes: boolean): number {
+  const planned = tempo.hold[i]!;
+  if (
+    !Number.isFinite(planned) ||
+    beat.kind === 'stoppage' ||
+    beat.reason === 'layoff' ||
+    (beat.original !== undefined && isShot(beat.original))
+  )
+    return beat.hold;
+  const due = tempo.at[i]! + tempo.offset + (scenes ? tempo.scene[i]! : 0);
+  const behind = t - due;
+  const restart = beat.original !== undefined && isRestart(beat.original);
+  const max = restart ? TEMPO.maxRestartHold : TEMPO.maxHold;
+  const min = Math.min(beat.hold, TEMPO.minHold);
+  const hold = planned - behind * TEMPO.catchUp;
+  return Math.round(Math.min(Math.max(hold, min), max) * 100) / 100;
+}
