+/**
+ * Several substitutions at one stoppage are made together, as a bench makes them: the men coming
+ * off walk to the gate at once, leave in the record's order with their replacements coming on, and
+ * the replacements walk to their places together (natural-football b: one at a time, four changes
+ * held the ball dead for two minutes).
+ */
+function* substitutions(
+  state: StageState,
+  ctx: BeatContext,
+  subs: readonly ScriptIncident[],
+): Generator<void, void> {
+  const start = state.t;
+  const leavers = subs.map((x) => participant(state, x.side, x.line));
+  const entrants = subs.map((x) => {
+    if (x.other === undefined) throw invalidDetail('staging:input');
+    return participant(state, x.side, x.other);
+  });
+  for (const a of leavers)
+    if (onPitch(state.fixture, a)) state.orders.set(a, { target: SCENE.gate, pace: 'walk' });
+  const gone = (a: number) =>
+    !onPitch(state.fixture, a) || dist(state.bodies[a].pos, SCENE.gate) <= SCENE.ready;
+  yield* runUntil(state, () => leavers.every(gone), SCENE.maxTravel);
+  subs.forEach((x, k) => {
+    const actor = leavers[k],
+      other = entrants[k];
+    if (onPitch(state.fixture, actor)) {
+      if (!gone(actor)) throw invalidDetail('staging:input');
+      state.fixture.present![actor] = false;
+      state.orders.delete(actor);
+      state.bodies[actor].vel = [0, 0];
+      pushEvent(state, {
+        kind: 'exit',
+        team: state.fixture.players[actor].team,
+        actor,
+        at: SCENE.gate,
+      });
+      refreshFrame(state);
+    }
+    state.fixture.present![other] = true;
+    state.enteredAt![other] = state.clock ?? state.t;
+    state.seen = [];
+    pushEvent(state, { kind: 'sub', team: x.side, actor, other, at: SCENE.gate });
+    keeperChange(state, x.side, ctx);
+    refreshFrame(state);
+  });
+  const targets = entrants.map((o) =>
+    nominalSpot(
+      { fixture: state.fixture, ball: state.ball.pos, team: state.team, phase: state.phase },
+      o,
+    ),
+  );
+  entrants.forEach((o, k) => state.orders.set(o, { target: targets[k], pace: 'walk' }));
+  const placed = () => entrants.every((o, k) => dist(state.bodies[o].pos, targets[k]) <= SCENE.ready);
+  yield* runUntil(state, placed, SCENE.maxTravel);
+  if (!placed()) throw invalidDetail('staging:input');
+  yield* holdScene(state, Math.max(0, SCENE.substitution - (state.t - start)));
+  for (const x of subs) keeperChange(state, x.side, ctx);
+}
