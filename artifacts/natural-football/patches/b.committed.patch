diff --git a/packages/engine/src/script/order.test.ts b/packages/engine/src/script/order.test.ts
new file mode 100644
index 00000000..09c4cdc2
--- /dev/null
+++ b/packages/engine/src/script/order.test.ts
@@ -0,0 +1,120 @@
+// The order of play reads as football (natural-football b): links are touches into the next
+// cell, a run forward is not turned round into a back pass, and every back pass has its reason.
+import { describe, expect, it } from 'vitest';
+import { cellAt, dist, pointAway, toAttack } from './cells';
+import { minuteTimes } from './clock';
+import { SCRIPT_CONFIG } from './config';
+import type { MatchDetail as Settled } from './detail';
+import type { Beat, Script } from './types';
+import { writePeriods } from './write';
+import { loadDetail } from '../../../../tests/fixtures/match-script';
+
+const write = (detail: Settled): Script => {
+  const result = writePeriods(detail, 'fit');
+  if ('problems' in result) throw new Error(`${detail.id}: ${result.problems.join(';')}`);
+  return result.script;
+};
+const scripts = (['s01', 's02', 's03'] as const).map((id) => [id, write(loadDetail(id))] as const);
+const ax = (b: Beat, p: readonly [number, number]) => toAttack(b.side, p)[0];
+const B = SCRIPT_CONFIG.backPass;
+/** The most a link can need from a reception led to an edge-adjacent cell: both margins and the depth. */
+const TOUCH = 2 * SCRIPT_CONFIG.cellMargin + SCRIPT_CONFIG.leadDepth + 1e-6;
+
+describe('the order of play (natural-football b)', () => {
+  it('a pass whose receiver plays on from the next cell is received on its side: the link is a touch', () => {
+    for (const [id, script] of scripts) {
+      let adjacent = 0,
+        touches = 0;
+      script.beats.forEach((b, k) => {
+        const p = script.beats[k - 1];
+        if (b.move !== 'link' || !p || p.side !== b.side || p.actor === b.actor) return;
+        if (p.outcome !== 'complete') return;
+        const a = cellAt(b.side, b.from),
+          c = cellAt(b.side, b.to);
+        const steps = Math.abs(Math.floor(a / 5) - Math.floor(c / 5)) + Math.abs((a % 5) - (c % 5));
+        if (steps !== 1) return;
+        adjacent++;
+        if (dist(b.from, b.to) <= TOUCH) touches++;
+      });
+      expect(adjacent, id).toBeGreaterThan(50);
+      expect(touches / adjacent, id).toBeGreaterThan(0.7);
+    }
+  });
+
+  it('every pass played back far enough to need one has its reason', () => {
+    for (const [id, script] of scripts) {
+      const back = script.beats.filter(
+        (b) => b.kind === 'pass' && ax(b, b.from) - ax(b, b.to) >= B.back,
+      );
+      expect(back.length, id).toBeGreaterThan(50);
+      for (const b of back) expect(b.reason, `${id} beat ${b.index}`).toBeDefined();
+      // A lay-off is first time: the beat before it is the completed pass that gave him the ball.
+      for (const b of back.filter((x) => x.reason === 'layoff')) {
+        const before = script.beats[b.index - 1]!;
+        expect(before.receiver, `${id} beat ${b.index}`).toBe(b.actor);
+        expect(before.outcome).toBe('complete');
+      }
+      // The presser is staged closing him down, so a pressed back pass is played up the pitch.
+      for (const b of back.filter((x) => x.reason === 'pressed'))
+        expect(ax(b, b.from), `${id} beat ${b.index}`).toBeGreaterThanOrEqual(B.pressedX);
+    }
+  });
+
+  it('a man who links the ball a cell forward rarely turns round and passes it back', () => {
+    for (const [id, script] of scripts) {
+      let turned = 0,
+        back = 0;
+      script.beats.forEach((b, k) => {
+        if (b.kind !== 'pass' || ax(b, b.from) - ax(b, b.to) < B.back) return;
+        back++;
+        const p = script.beats[k - 1];
+        if (p?.move === 'link' && p.actor === b.actor && ax(p, p.to) - ax(p, p.from) >= B.back)
+          turned++;
+      });
+      expect(turned / back, id).toBeLessThan(0.03);
+    }
+  });
+
+  it('a first-time lay-off takes the shortest hold; the minute shares the rest', () => {
+    const beat = (index: number, reason?: Beat['reason']): Beat => ({
+      index,
+      possession: 0,
+      side: 0,
+      phase: 'progression',
+      move: 'short',
+      kind: 'pass',
+      actor: 1,
+      receiver: 2,
+      from: [50, 30],
+      to: [42, 30],
+      loft: false,
+      through: false,
+      header: false,
+      hold: 0,
+      clock: 0,
+      period: 1,
+      outcome: 'complete',
+      ...(reason && { reason }),
+    });
+    // Twenty beats a minute: their share is within `hold`, so the minute stays sixty seconds.
+    const plain = minuteTimes(
+      Array.from({ length: 20 }, (_, k) => beat(k)),
+      10,
+    );
+    const laid = minuteTimes(
+      Array.from({ length: 20 }, (_, k) => beat(k, k === 1 ? 'layoff' : undefined)),
+      10,
+    );
+    expect(laid.holds[1]).toBe(SCRIPT_CONFIG.hold[0]);
+    expect(laid.holds[0]).toBeGreaterThan(plain.holds[0]!);
+    expect(laid.need).toBeCloseTo(plain.need, 6);
+  });
+
+  it('a point kept a pass length from the ball moves straight away from it, not to a far corner', () => {
+    // Band 6 lane 0 of side 0 (x 88.5–99.5, y 0–13.84); the ball 3 m from the wanted point.
+    const ball: [number, number] = [90, 15.34];
+    const p = pointAway(0, 30, [91.5, 12.34], ball, SCRIPT_CONFIG.minPass);
+    expect(dist(p, ball)).toBeCloseTo(SCRIPT_CONFIG.minPass, 6);
+    expect(p[0]).toBeLessThan(95);
+  });
+});
