new file mode 100644
index 00000000..2302be93
--- /dev/null
+++ b/packages/engine/src/staging/takeon.test.ts
@@ -0,0 +1,112 @@
+import { describe, expect, it } from 'vitest';
+import { STAGING_CONFIG } from './config';
+import { demoFixture } from './squads.testkit';
+import type { Playback, Vec } from './types';
+import { dot, sub } from './vec';
+import { performScript, posOf, scriptOf, type BeatSpec } from './script.testkit';
+import { takeOnLine } from './takeon';
+
+// The owner's rule (261113): a carrier held up by his man may face him off, but once he has gone
+// past him he goes on; he never comes back to him or goes round in circles.
+const fixture = demoFixture();
+const STAGE = STAGING_CONFIG.stage;
+const TAKE_ON = STAGE.takeOn;
+
+/** Home (index = slot) attacks +x in the first half; H6 receives on [50, 24]. */
+const K: BeatSpec = { kind: 'kickOff', actor: 9, receiver: 5, to: [45, 30] };
+const TO_6: BeatSpec = { kind: 'pass', actor: 5, receiver: 6, to: [50, 24] };
+const ON: BeatSpec = { kind: 'pass', actor: 6, receiver: 9, to: [72, 34] };
+
+/** Home player `index`'s x through beat `beat` (from `skip` seconds into it). */
+const xsOf = (p: Playback, beat: number, index: number, skip = 0): number[] => {
+  const frames = p.frames.filter((f) => f.beat === beat);
+  const from = (frames[0]?.t ?? 0) + skip;
+  return frames.filter((f) => f.t >= from).map((f) => posOf(f, index)[0]);
+};
+
+/** The most he gives back toward his own goal (−x) from the furthest he has been. */
+const givenBack = (xs: readonly number[]): number => {
+  let best = -Infinity;
+  let back = 0;
+  for (const x of xs) {
+    best = Math.max(best, x);
+    back = Math.max(back, best - x);
+  }
+  return back;
+};
+
+/** Total absolute heading change (degrees) of a path sampled at points `step` metres apart. */
+const turning = (path: readonly Vec[], step = 1): number => {
+  const pts: Vec[] = path.slice(0, 1);
+  for (const q of path) {
+    const last = pts[pts.length - 1];
+    if (Math.hypot(q[0] - last[0], q[1] - last[1]) >= step) pts.push(q);
+  }
+  let total = 0;
+  for (let k = 2; k < pts.length; k++) {
+    const a = Math.atan2(pts[k - 1][1] - pts[k - 2][1], pts[k - 1][0] - pts[k - 2][0]);
+    const b = Math.atan2(pts[k][1] - pts[k - 1][1], pts[k][0] - pts[k - 1][0]);
+    let d = b - a;
+    while (d > Math.PI) d -= 2 * Math.PI;
+    while (d < -Math.PI) d += 2 * Math.PI;
+    total += Math.abs(d);
+  }
+  return (total * 180) / Math.PI;
+};
+
+describe('takeOnLine', () => {
+  it('keeps an end that lies beyond the man', () => {
+    const r = takeOnLine([50, 30], [60, 30], [1, 0]);
+    expect(r.end).toEqual([60, 30]);
+    expect(r.way).toEqual([1, 0]);
+    expect(r.stand).toBe(STAGE.jockey);
+  });
+
+  it('never points back and always ends past the man', () => {
+    for (const to of [
+      [46, 31],
+      [50.5, 30],
+      [51, 36],
+    ] as Vec[]) {
+      const r = takeOnLine([50, 30], to, [1, 0]);
+      expect(r.way[0]).toBeGreaterThanOrEqual(0);
+      expect(dot(sub(r.end, [50, 30]), r.way)).toBeGreaterThanOrEqual(
+        r.stand + TAKE_ON.past - 1e-9,
+      );
+    }
+  });
+});
+
+describe('a carrier and his man', () => {
+  it('a take-on that ends level with its start still goes on past the defender, never back', () => {
+    const takeOn: BeatSpec = { kind: 'takeOn', actor: 6, to: [49, 26], opponent: 17, hold: 1 };
+    const p = performScript(scriptOf(fixture, [K, TO_6, takeOn, ON]), { duration: 40 });
+    // After the face-off (the beat's hold), in which he pulls up from the run he received on.
+    const all = p.frames.filter((f) => f.beat === 2);
+    const frames = all.filter((f) => f.t >= all[0].t + 1);
+    expect(frames.length).toBeGreaterThan(0);
+    const start = posOf(frames[0], 6);
+    const { way } = takeOnLine(start, takeOn.to, [1, 0]);
+    expect(way[0]).toBeGreaterThanOrEqual(0);
+    const along = frames.map((f) => dot(sub(posOf(f, 6), start), way));
+    expect(along[along.length - 1]).toBeGreaterThanOrEqual(TAKE_ON.stand + TAKE_ON.past - 0.6);
+    // At most the pull-up on the end (`stage.arrive`), far inside the 3 m of a carrier coming back.
+    expect(givenBack(along)).toBeLessThanOrEqual(1);
+    // Across the pitch he steps round his man on the side toward the attack and comes level
+    // again, never back toward his own goal by the 3 m that reads as coming back.
+    expect(givenBack(xsOf(p, 2, 6, 1))).toBeLessThan(3);
+  });
+
+  it('a pressed carrier holds it up without backing off or going round his presser', () => {
+    const pressed: BeatSpec = { ...ON, reason: 'pressed', hold: 3 };
+    const p = performScript(scriptOf(fixture, [K, TO_6, pressed]), { duration: 40 });
+    const frames = p.frames.filter((f) => f.beat === 2);
+    const kick = p.events.find((e) => e.kind === 'kick' && e.beat === 2);
+    expect(kick).toBeDefined();
+    const held = frames.filter((f) => f.t <= (kick?.t ?? 0));
+    // From half a second in: the first touch may still carry his arrival's momentum.
+    const settled = held.filter((f) => f.t >= held[0].t + 0.5);
+    expect(givenBack(settled.map((f) => posOf(f, 6)[0]))).toBeLessThanOrEqual(0.5);
+    expect(turning(held.map((f) => posOf(f, 6)))).toBeLessThan(180);
+  });
+});
