+++ b/packages/engine/src/script/order.test.ts
@@ -0,0 +1,124 @@
+import { describe, expect, it } from 'vitest';
+import { loadDetail, fixtureSeed } from '../../../../tests/fixtures/match-script';
+import { toAttack } from './cells';
+import { minuteTimes } from './clock';
+import { SCRIPT_CONFIG, SCRIPT_ORDER } from './config';
+import { scriptCost } from './count';
+import type { Beat, Script } from './types';
+import { isPassLike } from './types';
+import { writeScript } from './write';
+
+const TEN = ['s01', 's02', 's03', 's04', 's05', 's06', 's07', 's08', 's09', 's10'];
+const ten = TEN.map((id) => {
+  const detail = loadDetail(id);
+  const written = writeScript(detail, fixtureSeed(id));
+  if (!('script' in written)) throw new Error(`${id}: ${written.problems.join(', ')}`);
+  return { id, detail, script: written.script };
+});
+const upfield = (b: Beat): number => toAttack(b.side, b.to)[0] - toAttack(b.side, b.from)[0];
+const length = (b: Beat): number => Math.hypot(b.to[0] - b.from[0], b.to[1] - b.from[1]);
+const recordedPasses = (script: Script) =>
+  script.beats.flatMap((b, i) =>
+    b.kind === 'pass' && b.event !== undefined ? [[b, i] as const] : [],
+  );
+
+describe('the order of play reads football (SCRIPT_ORDER)', () => {
+  it('builds toward where play goes, so its links stay short', () => {
+    // Released writer (T840) on these ten: 54,014 m of links; aiming each ball at the side of its
+    // cell where the man plays on and building toward the minute's owed touch: 36,172 m.
+    const metres = ten.reduce((sum, x) => sum + scriptCost(x.script, x.detail).linkMetres, 0);
+    expect(metres).toBeLessThanOrEqual(36_172 * 1.02);
+  });
+
+  it('a man is seldom dragged upfield by a link only to play the ball back', () => {
+    // A link of 8 m or more upfield straight into the same man's backward pass: 68 on these ten
+    // under the released writer, 25 now.
+    let count = 0;
+    for (const { script } of ten)
+      for (const [b, i] of recordedPasses(script)) {
+        const before = script.beats[i - 1];
+        if (before?.move === 'link' && before.actor === b.actor && upfield(before) >= 8)
+          if (upfield(b) <= -3) count++;
+      }
+    expect(count).toBeLessThanOrEqual(30);
+  });
+
+  it('every ball played back from the final third shows why', () => {
+    let backward = 0;
+    for (const { id, script } of ten)
+      for (const [b, i] of recordedPasses(script)) {
+        const x = toAttack(b.side, b.from)[0];
+        if (x < SCRIPT_CONFIG.phaseX.finalThird || upfield(b) > -SCRIPT_ORDER.backCue) continue;
+        backward++;
+        expect(['cutBack', 'layoff', 'pressed'], `${id}#${b.index}`).toContain(b.reason);
+        if (b.reason !== 'layoff') continue;
+        // A lay-off is played first time off the pass that found him.
+        expect(b.hold, `${id}#${b.index}`).toBeLessThanOrEqual(SCRIPT_CONFIG.hold[0]);
+        let k = i - 1;
+        while (
+          script.beats[k]!.actor === b.actor &&
+          script.beats[k]!.side === b.side &&
+          (script.beats[k]!.kind === 'carry' || script.beats[k]!.kind === 'takeOn')
+        ) {
+          expect(length(script.beats[k]!)).toBeLessThanOrEqual(SCRIPT_ORDER.layoffTouch);
+          k--;
+        }
+        const fed = script.beats[k]!;
+        expect(isPassLike(fed.kind) && fed.receiver === b.actor && fed.outcome === 'complete').toBe(
+          true,
+        );
+      }
+    expect(backward).toBeGreaterThan(100);
+  });
+
+  it('no other pass carries a cue', () => {
+    for (const { script } of ten)
+      for (const [b] of recordedPasses(script)) {
+        if (b.reason === undefined || b.reason === 'cutBack') continue;
+        expect(toAttack(b.side, b.from)[0]).toBeGreaterThanOrEqual(SCRIPT_CONFIG.phaseX.finalThird);
+        expect(upfield(b)).toBeLessThanOrEqual(-SCRIPT_ORDER.backCue);
+      }
+  });
+});
+
+describe('minute clock (minuteTimes)', () => {
+  const beat = (over: Partial<Beat>): Beat =>
+    ({
+      index: 0,
+      possession: 0,
+      side: 0,
+      phase: 'progression',
+      move: 'short',
+      kind: 'pass',
+      actor: 1,
+      from: [40, 30],
+      to: [50, 30],
+      outcome: 'complete',
+      loft: false,
+      through: false,
+      header: false,
+      hold: 0,
+      clock: 0,
+      period: 1,
+      ...over,
+    }) as Beat;
+
+  it('a lay-off holds the shortest hold and leaves the rest of the minute to the others', () => {
+    const list = Array.from({ length: 12 }, (_, k) =>
+      beat({ index: k, ...(k === 5 && { reason: 'layoff' as const }) }),
+    );
+    const { holds, need } = minuteTimes(list, 10);
+    expect(holds[5]).toBe(SCRIPT_CONFIG.hold[0]);
+    expect(holds[4]).toBeGreaterThan(holds[5]!);
+    expect(need).toBeCloseTo(60, 6);
+  });
+
+  it('a minute of few beats spans its sixty seconds, no man holding the ball beyond longHold', () => {
+    const few = [beat({}), beat({ index: 1 }), beat({ index: 2 })];
+    const spread = minuteTimes(few, 10);
+    expect(spread.holds.every((h) => h > SCRIPT_CONFIG.hold[1])).toBe(true);
+    expect(spread.holds.every((h) => h <= SCRIPT_ORDER.longHold)).toBe(true);
+    const six = Array.from({ length: 6 }, (_, k) => beat({ index: k }));
+    expect(minuteTimes(six, 10).need).toBeCloseTo(60, 6);
+  });
+});
