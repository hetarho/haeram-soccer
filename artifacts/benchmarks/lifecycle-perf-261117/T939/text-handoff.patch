@@ -0,0 +1,57 @@
+import { describe, expect, it } from 'vitest';
+import type { World } from '../../../../packages/contracts/src/types';
+import { simulatedWorld } from '../../../../tests/fixtures/worlds';
+import { build, serve, type CodecTextJob } from './codec';
+import type { CodecResult } from './protocol';
+import { startedWorld } from './host.testkit';
+
+const JOB = { id: 'save', generation: 3, parentGeneration: 2 };
+const text = (world: World): CodecTextJob => ({ ...JOB, text: JSON.stringify(world) });
+
+describe('codec text jobs (→SAVE-8, ARCH-13)', () => {
+  it('builds the same checkpoint from the world JSON text as from the world', async () => {
+    const fresh = startedWorld();
+    const played = simulatedWorld({ country: 'ENG', seed: 'season-archive' }, { seasons: 1 });
+    // The second career carries what an autosave hands over at length: NPC careers, closed
+    // seasons and free agents.
+    expect(Object.keys(played.squads ?? {}).length).toBeGreaterThan(0);
+    expect(Object.keys(played.playerRecords ?? {}).length).toBeGreaterThan(0);
+    expect(played.history.length).toBeGreaterThan(0);
+    expect(played.freeAgents?.length).toBeGreaterThan(0);
+    for (const world of [fresh, played]) {
+      const fromWorld = await build({ ...JOB, world });
+      const fromText = await build(text(world));
+      if (!fromWorld.ok) throw new Error(fromWorld.error);
+      expect(fromText).toEqual(fromWorld);
+    }
+  });
+  it('answers a world that fails validation or text that is no world, never throwing', async () => {
+    const world = startedWorld();
+    world.rankHistory![0]!.rows[0]![0] = world.clubs.length;
+    const fromWorld = await build({ ...JOB, world });
+    expect(fromWorld.ok).toBe(false);
+    expect(await build(text(world))).toEqual(fromWorld);
+    for (const unreadable of ['', '{', 'null'])
+      expect(await build({ ...JOB, text: unreadable })).toMatchObject({
+        id: 'save',
+        ok: false,
+      });
+  });
+  it('serves text jobs from its port one at a time', async () => {
+    const world = startedWorld();
+    const channel = new MessageChannel();
+    const answers: CodecResult[] = [];
+    const answered = new Promise<void>((resolve) =>
+      serve(channel.port1, (result) => answers.push(result) === 2 && resolve()),
+    );
+    channel.port2.postMessage({ ...text(world), id: 'first' });
+    channel.port2.postMessage({ ...JOB, id: 'second', text: '{' });
+    await answered;
+    channel.port1.close();
+    expect(answers.map((answer) => [answer.id, answer.ok])).toEqual([
+      ['first', true],
+      ['second', false],
+    ]);
+    expect(answers[0]).toEqual({ ...(await build({ ...JOB, world })), id: 'first' });
+  });
+});
