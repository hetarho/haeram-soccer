+
+describe('bench scan', () => {
+  const POSITIONS: Player['position'][] = ['GK', 'CB', 'LB', 'DM', 'CM', 'AM', 'LW', 'ST'];
+  function pool(seed: string, size: number, positions = POSITIONS, tie = false): Player[] {
+    return Array.from({ length: size }, (_, i) => {
+      const p = makePlayer(
+        'ENG',
+        seed,
+        `bench:${seed}:${tie ? i % 5 : i}`,
+        1950,
+        tie ? 60 : 50 + (i % 23),
+        positions[i % positions.length]!,
+        18 + (i % 15),
+      );
+      return p;
+    });
+  }
+  function shuffled<T>(items: T[], seed: string): T[] {
+    const out = [...items];
+    for (let i = out.length - 1; i > 0; i--) {
+      const j = integer(random(`${seed}:${i}`), 0, i);
+      [out[i], out[j]] = [out[j]!, out[i]!];
+    }
+    return out;
+  }
+  /** matchdaySquad as it chose before the scan: every bench place sorted. */
+  function referenceSquad(w: World, c: Club, players: Player[]) {
+    const style = clubStyle(c),
+      manager = clubManager(w, c),
+      chosen = lineup(players, style, manager, w.year),
+      used = new Set(chosen.map((p) => p.id));
+    for (const place of squadPlaces(style).slice(chosen.length)) {
+      const remaining = players.filter((p) => !used.has(p.id));
+      const line = remaining.filter((p) => lineOf(p.position) === lineOf(place.position));
+      const slot = formationOf(style).find((s) => s.position === place.position)!;
+      const next = sortedBench(line.length ? line : remaining, (p) =>
+        selectionValue(p, slot, manager, w.year),
+      );
+      if (!next) break;
+      chosen.push(next);
+      used.add(next.id);
+    }
+    return chosen;
+  }
+
+  it('picks the same bench as the sort for every formation, pool size, tie and missing cover', () => {
+    const w = fixture(),
+      base = w.clubs[1]!;
+    const formations = new Set<string>();
+    for (let n = 0; n < 60 && formations.size < 4; n++) {
+      const c = { ...base, id: `ENG:0:0:${n}` };
+      const style = clubStyle(c);
+      if (formations.has(style)) continue;
+      formations.add(style);
+      for (const size of [18, 22, 40])
+        for (const [label, positions, tie] of [
+          ['mixed', POSITIONS, false],
+          ['ties', POSITIONS, true],
+          // no goalkeeper and no forward: bench lines fall back to the remaining pool
+          ['uncovered', ['CB', 'CM', 'DM'] as Player['position'][], false],
+        ] as const) {
+          const players = pool(`${style}:${size}:${label}`, size, [...positions], tie);
+          for (const k of [0, 1, 2]) {
+            const input = shuffled(players, `${style}:${size}:${label}:${k}`);
+            const got = matchdaySquad(w, c, input).map((p) => p.id);
+            expect(got).toEqual(referenceSquad(w, c, input).map((p) => p.id));
+          }
+        }
+    }
+    expect(formations.size).toBe(4);
+  });
+
+  it('breaks a complete tie by id, then by first input, as the sort did', () => {
+    const [a, b] = pool('tie', 2);
+    const same = { ...a!, id: 'zz' },
+      twin = { ...a!, id: 'zz' };
+    for (const input of [
+      [a!, b!],
+      [b!, a!],
+      [same, twin],
+      [twin, same],
+    ]) {
+      const flat = () => 5;
+      expect(pickBench(input, flat)).toBe(sortedBench(input, flat));
+    }
+    expect(pickBench([], () => 1)).toBeUndefined();
+  });
+
+  it('keeps the sort path when a value is not finite', () => {
+    const players = pool('nan', 12);
+    for (const bad of [Number.NaN, Infinity, -Infinity]) {
+      const valueOf = (p: Player) => (p.id.endsWith(':3') ? bad : p.born);
+      expect(pickBench(players, valueOf)).toBe(sortedBench(players, valueOf));
+    }
+  });
+});
