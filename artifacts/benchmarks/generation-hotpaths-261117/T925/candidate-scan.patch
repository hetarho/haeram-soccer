+/**
+ * The candidate with the highest value, then the lowest id, the first input winning a complete tie:
+ * one scan with each value read once. A value that is not finite keeps the ordered sort.
+ */
+export function pickBench(pool: Player[], valueOf: (p: Player) => number): Player | undefined {
+  let best: Player | undefined,
+    bestValue = 0;
+  for (const p of pool) {
+    const value = valueOf(p);
+    if (!Number.isFinite(value)) {
+      return pool
+        .map((q) => ({ p: q, value: valueOf(q) }))
+        .sort((a, b) => b.value - a.value || compareIds(a.p.id, b.p.id))[0]?.p;
+    }
+    if (!best || value > bestValue || (value === bestValue && compareIds(p.id, best.id) < 0)) {
+      best = p;
+      bestValue = value;
+    }
+  }
+  return best;
+}
