+// Membership is fixed while one tick reads its position snapshot. A fresh snapshot after a
+// substitution/exit gets fresh lists; the fixture guard also permits shared synthetic positions.
+const rosterCache = new WeakMap<readonly Vec[], { fixture: Fixture; teams: PlayerSpec[][] }>();
+const presentAt = (fixture: Fixture, snapshot: readonly Vec[], team: TeamId) => {
+  let cached = rosterCache.get(snapshot);
+  if (!cached || cached.fixture !== fixture) {
+    cached = { fixture, teams: [presentPlayers(fixture, 0), presentPlayers(fixture, 1)] };
+    rosterCache.set(snapshot, cached);
+  }
+  return cached.teams[team]!;
+};
 
