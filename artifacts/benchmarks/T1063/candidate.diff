+import { expect, it } from 'vitest';
+import type { World } from '../../../../packages/contracts/src/types';
+import { worldMarketFixture } from '../../../../packages/engine/src/world-market.testkit';
+import { foundSquads } from '../../../../packages/engine/src/persisted-squads';
+import { playingChanged, retainPerson } from '../../../../packages/engine/src/person-careers';
+import { clubPlayers, invalidateNpcSquads, makePlayer } from '../../../../packages/engine/src/world';
+import { disciplineNames } from './disciplineNames';
+
+/** The read before T1063: every club's whole squad drawn and searched. */
+function everySquad(w: World) {
+  const ids = new Set([
+    ...Object.keys(w.discipline?.yellows ?? {}),
+    ...(w.discipline?.bans ?? []).map((ban) => ban.player),
+  ]);
+  const names: [string, { name: string; club: string }][] = [];
+  if (ids.size)
+    for (const club of w.clubs)
+      for (const player of clubPlayers(w, club))
+        if (ids.has(player.id)) names.push([player.id, { name: player.name, club: club.id }]);
+  return Object.fromEntries(names);
+}
+
+const booked = (w: World, players: string[]) => {
+  w.discipline = {
+    year: w.year,
+    yellows: Object.fromEntries(players.map((id) => [id, { league: 1 }])),
+    bans: [],
+    out: [],
+  };
+};
+
+it('T1063-read-parity: names the table as reading every squad does, drawing only the clubs it names', () => {
+  const w = worldMarketFixture();
+  const representative = w.clubs.find((club) => club.id === 'representative')!;
+  representative.representative = true;
+  foundSquads(w);
+  expect(w.squads?.representative).toBeUndefined();
+  // Someone who now plays for the representative club, holding one of its generated places.
+  const arrival = makePlayer('ENG', 'market-unit', 'arrival', 1950, 50, 'ST', 25, 0);
+  retainPerson(w, arrival, 'representative');
+  playingChanged(w);
+  invalidateNpcSquads(w);
+  const drawn = clubPlayers(w, representative);
+  expect(drawn.some((p) => p.id === 'arrival')).toBe(true);
+  const generated = drawn.find((p) => p.id.startsWith('representative:'))!;
+  const own = w.players[0]!.id,
+    stored = w.squads!.foreign![0]!.id;
+
+  // A generated place, an arrival, a stored and an own player, and someone in no squad.
+  booked(w, [generated.id, 'arrival', stored, own, 'retired-nobody']);
+  const names = disciplineNames(w);
+  expect(names).toEqual(everySquad(w));
+  expect(JSON.stringify(names)).toBe(JSON.stringify(everySquad(w)));
+  expect(names[generated.id]).toEqual({ name: generated.name, club: 'representative' });
+  expect(names.arrival).toEqual({ name: arrival.name, club: 'representative' });
+  expect(names['retired-nobody']).toBeUndefined();
+
+  // The arrival alone still finds him; nobody of the representative club is the same answer too.
+  booked(w, ['arrival', own]);
+  expect(disciplineNames(w)).toEqual(everySquad(w));
+  booked(w, [stored, own]);
+  invalidateNpcSquads(w);
+  expect(disciplineNames(w)).toEqual(everySquad(w));
+  expect(Object.values(disciplineNames(w)).map((x) => x.club)).toEqual(['own', 'foreign']);
+});
