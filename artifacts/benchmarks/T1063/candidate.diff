+/** A club whose squad is drawn on each read (a representative club, →WORLD-6): no stored squad. */
+const drawn = (w: World, club: Club) => club.id !== w.playerClub && !w.squads?.[club.id];
+
+/**
+ * The drawn clubs that can hold any of `ids`. Their players are their generated places
+ * (`<club>:p:…`), those places' refills (`<club>:vacancy:…`) and the people playing for them
+ * (`continuousSquad`), so a club none of `ids` points to is not drawn: drawing every one again after
+ * each day's squad invalidation was most of this read (T1063), and every entry it could name is
+ * still found. Only an ID beginning like a drawn club's is cut at its colons.
+ */
+function drawnHolders(w: World, ids: ReadonlySet<string>) {
+  const clubs = new Set<string>(),
+    heads = new Set<string>(),
+    holders = new Set<string>();
+  for (const club of w.clubs)
+    if (drawn(w, club)) {
+      clubs.add(club.id);
+      heads.add(club.id.split(':', 1)[0]!);
+      if (playingFor(w, club.id).some((person) => ids.has(person.id))) holders.add(club.id);
+    }
+  for (const id of ids) {
+    let at = id.indexOf(':');
+    if (at < 0 || !heads.has(id.slice(0, at))) continue;
+    for (; at > 0; at = id.indexOf(':', at + 1)) {
+      const prefix = id.slice(0, at);
+      if (clubs.has(prefix)) holders.add(prefix);
+    }
+  }
+  return holders;
+}
 
